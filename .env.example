# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only key for city search (Google Places API (New)). In Google Cloud:
# enable "Places API (New)", restrict the key to that API, and leave the
# application/website restriction off — requests come from our server, which
# sends no referrer, so a website-restricted key is rejected. Set a budget alert.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
